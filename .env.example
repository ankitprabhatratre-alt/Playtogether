# ─────────────────────────────────────────────────────────────────────────────
# PlayTogether configuration. Copy to `.env` (repo root or server/) and adjust.
# Placeholders only. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP/WebSocket server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Optional PostgreSQL. Leave empty to run fully in memory (rooms vanish on restart).
# Example: postgresql://USER:PASSWORD@localhost:5432/playtogether?schema=public
DATABASE_URL=

# Extra browser origins allowed to call the API / open sockets (comma separated).
# Same-origin is always allowed; in dev the Vite proxy makes everything same-origin.
CLIENT_ORIGINS=

# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limits).
TRUST_PROXY=false

# Set to true when the site is served over HTTPS (enables HSTS + upgrade-insecure-requests).
HTTPS_ONLY=false

# Space/comma separated CSP frame-ancestors (who may embed the app in an iframe). Empty = nobody.
FRAME_ANCESTORS=

# Serve the built client (client/dist) from the Node server. Defaults to true when NODE_ENV=production.
SERVE_CLIENT=

# Room lifecycle
ROOM_IDLE_TTL_MINUTES=30        # close rooms with no activity for this long
ROOM_MAX_AGE_HOURS=12           # hard upper bound on a room's life
HOST_TRANSFER_GRACE_SECONDS=30  # how long a disconnected host keeps the role
CLEANUP_INTERVAL_SECONDS=60     # how often the cleanup sweep runs

# Multiplies generic HTTP rate limits (room create/join/read). Passcode lockout is unaffected.
RATE_LIMIT_MULTIPLIER=1
